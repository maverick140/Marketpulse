APP_NAME=MarketPulse AI
APP_ENV=development
APP_VERSION=1.0.0
# Set DATA_MODE to 'live' for real-time market/macro/news feeds or 'demo' for offline synthetic catalog
DATA_MODE=live
DATABASE_URL=sqlite:///./marketpulse.db
CORS_ORIGINS=https://market-pulses.netlify.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Provider choices: 'free' / 'live', 'demo'
MARKET_PROVIDER=free
NEWS_PROVIDER=free
MACRO_PROVIDER=free
GEOPOLITICAL_PROVIDER=free
ANNOUNCEMENT_PROVIDER=free
# Cache TTL (seconds)
MARKET_CACHE_TTL_SECONDS=60
MACRO_CACHE_TTL_SECONDS=900
NEWS_CACHE_TTL_SECONDS=1800
